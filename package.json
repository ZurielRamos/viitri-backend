{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typeorm": "node --env-file-if-exists=.env node_modules/typeorm/cli.js -d dist/database/data-source.js",
    "migration:generate": "npm run build && npm run typeorm -- migration:generate",
    "migration:create": "node node_modules/typeorm/cli.js migration:create",
    "migration:run": "npm run build && npm run typeorm -- migration:run",
    "migration:revert": "npm run build && npm run typeorm -- migration:revert",
    "admin:promote": "npm run build && node --env-file-if-exists=.env dist/scripts/promote-super-admin.js",
    "admin:seed": "npm run build && node --env-file-if-exists=.env dist/scripts/seed-admin.js",
    "geo:co": "node scripts/build-geo-co.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.93",
    "@nestjs/ai": "^0.0.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/mail": "^0.0.2",
    "@nestjs/mapped-types": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/resilience": "^0.0.3",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/storage": "^0.0.5",
    "@nestjs/typeorm": "^12.0.3",
    "ai": "^7.0.177",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "^4.4.0",
    "jose": "^6.2.18",
    "mammoth": "^1.13.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "typeorm": "^1.1.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
