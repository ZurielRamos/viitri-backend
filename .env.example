NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=menu
# Crea las tablas desde las entidades al arrancar. Solo en desarrollo.
DB_SYNCHRONIZE=false

# Auth
# Genera uno con: openssl rand -base64 48
JWT_SECRET=
# Duración de la sesión en segundos (30 días)
JWT_EXPIRES_IN=2592000

# Invitaciones
INVITATION_ACCEPT_URL=http://localhost:3001/invitaciones/aceptar
INVITATION_TTL_HOURS=168

# Correo (SMTP)
# URL pública del sitio web, usada en los enlaces de los correos.
APP_URL=http://localhost:3001
# Remitente.
MAIL_FROM="viitri <no-reply@viitri.com>"
# Servidor SMTP. Con Mailgun: host smtp.mailgun.org, puerto 587 (o 465 con TLS
# directo) y el usuario y la clave de Domain settings > SMTP Credentials.
# El usuario es el correo completo, por ejemplo postmaster@mg.tudominio.com.
# Sin SMTP_HOST, en desarrollo los correos se escriben en var/mail como .eml.
# Con `docker compose up mailpit`: SMTP_HOST=localhost, SMTP_PORT=1030 y sin
# usuario ni clave (bandeja en http://localhost:8030).
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=viitri_app@viitri.com
SMTP_PASS=tu-clave-smtp

# Domicilios: distancia de la ruta con Google Maps Routes API
# (habilitar "Routes API" en Google Cloud). Sin clave no se cotizan domicilios.
GOOGLE_MAPS_API_KEY=
# google (por defecto) | straight_line (solo desarrollo: línea recta)
DISTANCE_PROVIDER=google

# WhatsApp: códigos OTP con la plantilla de autenticación de Strategee.
# WHATSAPP_API_URL es la URL completa del endpoint, no una URL base.
# Sin token o inbox, fuera de producción el código se escribe en el log.
WHATSAPP_API_URL=https://crm.example.com/api/v1/tu-cuenta/whatsapp/auth-template
WHATSAPP_API_TOKEN=tu-token
WHATSAPP_INBOX_ID=tu-inbox-id
WHATSAPP_TEMPLATE_NAME=autenticacion
WHATSAPP_LANGUAGE_CODE=es
# Notificaciones por plantillas de WhatsApp (docs/plantillas-whatsapp.md).
# Usan WHATSAPP_API_TOKEN y WHATSAPP_INBOX_ID. Con WHATSAPP_TEMPLATE_API_URL
# vacía no se envía nada: cada aviso se escribe en el log. Si falta el nombre
# de una plantilla, ese aviso se omite.
WHATSAPP_TEMPLATE_API_URL=
WHATSAPP_TEMPLATES_LANGUAGE_CODE=es_CO
WHATSAPP_TEMPLATE_PLAN_POR_VENCER=plan_por_vencer
WHATSAPP_TEMPLATE_PLAN_VENCE_HOY=plan_vence_hoy
WHATSAPP_TEMPLATE_PLAN_ULTIMO_DIA=plan_ultimo_dia
WHATSAPP_TEMPLATE_PLAN_PASO_A_BASICO=plan_paso_a_basico
WHATSAPP_TEMPLATE_PRUEBA_POR_TERMINAR=prueba_por_terminar
WHATSAPP_TEMPLATE_PAGO_RECIBIDO=pago_recibido
WHATSAPP_TEMPLATE_PAGO_RECHAZADO=pago_rechazado
WHATSAPP_TEMPLATE_NEGOCIO_LISTO=negocio_listo
WHATSAPP_TEMPLATE_PEDIDO_NUEVO=pedido_nuevo
WHATSAPP_TEMPLATE_RESERVA_NUEVA=reserva_nueva
WHATSAPP_TEMPLATE_PEDIDO_RECIBIDO=pedido_recibido
WHATSAPP_TEMPLATE_PEDIDO_ACEPTADO=pedido_aceptado
WHATSAPP_TEMPLATE_PEDIDO_LISTO=pedido_listo
WHATSAPP_TEMPLATE_PEDIDO_EN_CAMINO=pedido_en_camino
WHATSAPP_TEMPLATE_PEDIDO_RECHAZADO=pedido_rechazado
WHATSAPP_TEMPLATE_RESERVA_CONFIRMADA=reserva_confirmada
WHATSAPP_TEMPLATE_RESERVA_RECORDATORIO=reserva_recordatorio

# Inicio de sesión con Google (la API solo verifica el token de identidad)
# que devuelve Google; el Client ID debe coincidir con el de la web.
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Imágenes (logos y portadas). Google Cloud Storage con claves HMAC
# (Cloud Storage > Configuración > Interoperabilidad). El bucket puede ser
# privado: la API sirve las imágenes en API_PUBLIC_URL/media. Sin
# STORAGE_BUCKET, en desarrollo se guardan en var/uploads.
API_PUBLIC_URL=http://localhost:3000
STORAGE_BUCKET=tu-proyecto.firebasestorage.app
STORAGE_HMAC_ACCESS_KEY=tu-access-key
STORAGE_HMAC_SECRET=tu-secret
# Sugerencia de diseño según el logo, con un modelo con visión por OpenRouter
# (openrouter.ai/keys). Sin la clave, se usa solo el color del logo.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Pagos de los planes con Wompi (Dashboard → Desarrolladores → Secretos para integración técnica).
# Llaves de Sandbox: pub_test_… / test_integrity_… / test_events_…
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Notificaciones push (Web Push con VAPID, sin Firebase). Se generan una vez
# con `npx web-push generate-vapid-keys` (en api/). Sin ellas no se envía
# nada: cada aviso se escribe en el log. Si cambias las claves, los celulares
# tienen que volver a activar los avisos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@viitri.com
